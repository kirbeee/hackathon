# Base URL of the fundraising-api FastAPI service (see ../fundraising-api).
# Defaults to http://127.0.0.1:8000 if unset.
FUNDRAISING_API_URL=http://127.0.0.1:8000

# Solana RPC endpoint used by the wallet-connect button (app/providers.tsx).
# Defaults to devnet if unset.
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com
