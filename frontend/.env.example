# Base URL of the fundraising-api FastAPI service (see ../fundraising-api).
# Used from Server Components/Actions. Defaults to http://127.0.0.1:8000 if unset.
FUNDRAISING_API_URL=http://127.0.0.1:8000

# Same base URL, but readable from the browser bundle — Client Components
# (the real-SOL-payment donate/buy-shares flows) need this variant since
# FUNDRAISING_API_URL is not inlined into client code. Keep both in sync.
NEXT_PUBLIC_FUNDRAISING_API_URL=http://127.0.0.1:8000

# Solana RPC endpoint used by the wallet-connect button (app/providers.tsx).
# Defaults to devnet if unset.
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com

# Devnet-only demo treasury used by the reward-tier donation flow.
NEXT_PUBLIC_SOLANA_TREASURY_ADDRESS=9jH94MJzG2HPmDhvra5xwD2Ens6QNtQtvJ21m4pVpQxw

# Devnet SPL Token payment settings for the manual investment purchase button.
# Circle's official Solana devnet USDC mint.
NEXT_PUBLIC_USDC_MINT_ADDRESS=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU
# Replace None after the demo TWD mint and custom backend are ready.
NEXT_PUBLIC_TWD_MINT_ADDRESS=None
NEXT_PUBLIC_PAYMENT_TREASURY_ADDRESS=9pvghMD6tK7eUb8MQrue6LZ2t1NdTkUQMuQFgVgDGPi1
FUNDRAISING_PAYMENT_ENDPOINT=None

# Base URL of the rwa-agent FastAPI service (see ../rwa-agent) powering the
# AI Agent chat on /agent (app/api/agent/chat/route.ts proxies to it).
# Server-only — rwa-agent's port is never exposed to the browser or the
# public tunnel, only this Next.js server talks to it. Defaults to
# http://127.0.0.1:8100 if unset.
RWA_AGENT_URL=http://127.0.0.1:8100
